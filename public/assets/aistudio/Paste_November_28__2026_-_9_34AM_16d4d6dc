<script>
    let currentDifficulty = 'medium';

    function selectDifficulty(level) {
      currentDifficulty = level;
      const cards = ['easy', 'medium', 'hard'];

      cards.forEach(key => {
        const el = document.getElementById('card-' + key);
        const radio = el.querySelector('.radio-indicator');
        const check = el.querySelector('.radio-check');

        if (key === level) {
          el.setAttribute('aria-checked', 'true');
          el.classList.remove('border-[3px]', 'shadow-[4px_4px_0px_#000000]', 'ring-0');
          el.classList.add('border-[4px]', 'shadow-[6px_6px_0px_#000000]', 'ring-4', 'ring-primary-container');
          
          radio.classList.remove('bg-surface-container-low');
          radio.classList.add('bg-primary-container');
          check.classList.remove('hidden');
          check.classList.add('block');
        } else {
          el.setAttribute('aria-checked', 'false');
          el.classList.remove('border-[4px]', 'shadow-[6px_6px_0px_#000000]', 'ring-4', 'ring-primary-container');
          el.classList.add('border-[3px]', 'shadow-[4px_4px_0px_#000000]');

          radio.classList.remove('bg-primary-container');
          radio.classList.add('bg-surface-container-low');
          check.classList.remove('block');
          check.classList.add('hidden');
        }
      });
    }

    function triggerStart() {
      const btn = document.getElementById('btn-start');
      btn.style.transform = 'translate(4px, 4px)';
      btn.style.boxShadow = '0px 0px 0px #000000';
      
      setTimeout(() => {
        btn.style.transform = '';
        btn.style.boxShadow = '';
      }, 150);
    }

