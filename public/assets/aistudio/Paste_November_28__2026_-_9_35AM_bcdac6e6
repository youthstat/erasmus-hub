<span class="material-symbols-outlined text-[18px]" id="visibility-icon">visibility_off</span>
<span class="font-label-ui text-label-ui uppercase tracking-wide font-bold" id="visibility-label">TAP TO CONCEAL</span>
</div>
</button>
<!-- Rule Reminder Pill -->
<div class="flex justify-center pb-space-xs">
<div class="bg-surface-container-lowest border-[3px] border-on-background rounded-lg px-space-md py-space-xs shadow-[3px_3px_0px_#000000] flex items-center gap-space-xs">
<span class="material-symbols-outlined text-[18px] text-on-background">pan_tool</span>
<span class="font-label-ui text-label-ui text-on-background uppercase tracking-wide font-bold">GESTURES ONLY • NO SOUNDS</span>
</div>
</div>
</div>
<!-- Bottom Action Area -->
<div class="flex flex-col gap-space-md pt-space-xs pb-space-sm">
<button class="w-full bg-[#FFE600] border-[4px] border-on-background rounded-xl py-space-lg px-space-md shadow-[4px_4px_0px_#000000] active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all flex items-center justify-center gap-space-sm" id="btn-guessed" type="button"><span class="material-symbols-outlined text-on-background text-[26px]" style="font-variation-settings: &quot;FILL&quot; 1;">check_circle</span>
<span class="font-headline-sm text-headline-sm text-on-background uppercase tracking-wide font-extrabold">GOT IT!</span></button>
<div class="flex items-stretch gap-space-md">
<button class="flex-1 bg-[#BE123C] border-[3px] border-on-background rounded-xl py-space-md px-space-md shadow-[4px_4px_0px_#000000] active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all flex items-center justify-center gap-space-xs" id="btn-skip" type="button"><span class="material-symbols-outlined text-white text-[22px]">close</span>
<span class="font-headline-sm text-headline-sm text-white uppercase tracking-wide font-bold">PASS / SKIP</span></button>
<button aria-label="Pause" class="w-16 bg-surface-container-lowest border-[3px] border-on-background rounded-xl shadow-[4px_4px_0px_#000000] active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all flex items-center justify-center shrink-0" id="btn-pause" type="button">
<span class="material-symbols-outlined text-on-background text-[26px]" id="pause-icon">pause</span>
</button>
</div>
</div>
<script>
  (function() {
    let score = 12;
    let isPaused = false;
    let isHidden = false;
    const originalPhrase = "PIRATES OF THE CARIBBEAN";

    const scoreBadge = document.getElementById("score-badge");
    const scoreText = document.getElementById("score-text");
    const wordCard = document.getElementById("word-card");
    const wordPhrase = document.getElementById("word-phrase");
    const visibilityIcon = document.getElementById("visibility-icon");
    const visibilityLabel = document.getElementById("visibility-label");
    const btnGuessed = document.getElementById("btn-guessed");
    const btnSkip = document.getElementById("btn-skip");
    const btnPause = document.getElementById("btn-pause");
    const pauseIcon = document.getElementById("pause-icon");

    function updateScore(delta) {
      score = Math.max(0, score + delta);
      scoreText.textContent = score + " PTS";
      scoreBadge.classList.add("scale-110");
      setTimeout(() => scoreBadge.classList.remove("scale-110"), 150);
    }

    wordCard.addEventListener("click", () => {
      isHidden = !isHidden;
      if (isHidden) {
        wordPhrase.textContent = "••• CONCEALED •••";
        wordPhrase.classList.add("text-outline");
        visibilityIcon.textContent = "visibility";
        visibilityLabel.textContent = "TAP TO REVEAL";
      } else {
        wordPhrase.textContent = originalPhrase;
        wordPhrase.classList.remove("text-outline");
        visibilityIcon.textContent = "visibility_off";
        visibilityLabel.textContent = "TAP TO CONCEAL";
      }
    });

    btnGuessed.addEventListener("click", () => updateScore(2));
    btnSkip.addEventListener("click", () => updateScore(-1));

    btnPause.addEventListener("click", () => {
      isPaused = !isPaused;
      pauseIcon.textContent = isPaused ? "play_arrow" : "pause";
      if (isPaused) {
        btnPause.classList.add("bg-primary-container");
      } else {
        btnPause.classList.remove("bg-primary-container");
      }
    });
  })();
</script></main>

